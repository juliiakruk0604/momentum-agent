MODE=shadow
SERVICE_MODE=all
UNIVERSE_LIMIT=150
WORKER_SLEEP_SECONDS=60
WORKER_STALE_SECONDS=300
# Railway: set this in the app service as a reference to the Postgres service.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Optional later:
# COINGLASS_API_KEY=...
HISTORICAL_BACKFILL_ENABLED=true
HISTORICAL_BACKFILL_DAYS=60
HISTORICAL_HOLDOUT_DAYS=10
HISTORICAL_BACKFILL_SYMBOLS_PER_SCAN=1
